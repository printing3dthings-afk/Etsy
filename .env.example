# ── App & Business Identity (required) ────────────────────────────────────────
# Auth token for the dashboard/API. Generate a random one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never share this value — anyone with it has full dashboard access.
APP_SECRET_TOKEN=

# Your business name, your name, and what the agent should call itself.
# AGENT_NAME_SHORT is used in short user-facing messages where the full
# AGENT_NAME reads oddly — leave blank to default to AGENT_NAME with any
# "Fucking " prefix stripped.
BUSINESS_NAME=Your Business Name
OWNER_NAME=Your Name
AGENT_NAME=Frank
AGENT_NAME_SHORT=
BUSINESS_DESCRIPTION=a short description of what your business sells

# ── Anthropic (required) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Etsy API (read-only competitor research & shop data) ──────────────────────
# Get your API key: https://www.etsy.com/developers/ → Create App → copy Keystring
ETSY_API_KEY=your_etsy_keystring_here
ETSY_SHOP_ID=onbrandcraftz

# ── Etsy OAuth (required for listing creation and order management) ────────────
# Get from https://www.etsy.com/developers/ → your app → Keystring + Shared Secret
# Then run: python tools/etsy_oauth.py
ETSY_CLIENT_ID=your_etsy_keystring_here
ETSY_CLIENT_SECRET=your_etsy_shared_secret_here
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=

# Optional but recommended: encrypts the Etsy OAuth tokens db.py persists to
# hub.db at rest (2026-07-18 compliance hardening). Without it, tokens are
# stored in plaintext exactly as before this was added -- not a new risk, just
# a missed hardening opportunity. Generate one with:
#   python -c "import nacl.utils, nacl.secret, base64; print(base64.b64encode(nacl.utils.random(nacl.secret.SecretBox.KEY_SIZE)).decode())"
# Losing this key makes any already-encrypted stored token unrecoverable —
# back it up like any other secret. Rotating it does NOT require re-encrypting
# old rows by hand: the next OAuth refresh (hourly) re-saves under the new key.
TOKEN_ENCRYPTION_KEY=

# ── OpenAI / DALL-E 3 (required for AI art generation and logo creation) ───────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Alternative image-generation engines (optional -- OpenAI above already
#    covers everything; these unlock the other options in tools/image_gen.py's
#    engine= param / IMAGE_ENGINE setting) ─────────────────────────────────────
# Gemini "Nano Banana" -- get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Ideogram 3.0 -- get from https://ideogram.ai/manage-api
IDEOGRAM_API_KEY=your_ideogram_api_key_here
# xAI Grok Imagine (added 2026-08-05) -- get from https://console.x.ai/
# Also used for TEXT_ENGINE=grok (tag/title/description generation, the
# product classifier) once that's configured -- same key, one var covers both.
XAI_API_KEY=your_xai_api_key_here

# ── Email / Digital Delivery (required to email files to customers) ────────────
# Gmail setup: enable 2FA → myaccount.google.com/apppasswords → create App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SENDER_NAME=OnBrandCraftz

# ── Google Calendar API (read events into Frank's Calendar tab + push its own
#    due dates/deadlines onto your calendar) ─────────────────────────────────
# Get from console.cloud.google.com: enable the "Google Calendar API", configure
# the OAuth consent screen, then Credentials > Create Credentials > OAuth client
# ID (Application type: Desktop app).
# Redirect URI to register: http://localhost:3006/callback
# Then run: python tools/google_calendar_oauth.py
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ── Pinterest API (direct pin posting) ───────────────────────────────────────
# Get from https://developers.pinterest.com/ → Create App
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=

# ── Canva Connect API (automates "added in Canva post" listing graphics) ───────
# Get from https://www.canva.com/developers/integrations → Create an Integration
# Redirect URI to register: http://localhost:3005/callback
# Then run: python tools/canva_oauth.py
# NOTE: Canva's API cannot create a Brand Template — you must build at least one
# manually in the Canva UI (with named placeholder fields) before the
# generate_listing_graphic tool can be used.
CANVA_CLIENT_ID=your_canva_integration_client_id
CANVA_CLIENT_SECRET=your_canva_integration_client_secret
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# ── Instagram Graph API (photo/video/Reels posting) ─────────────────────────────
# Get from https://developers.facebook.com/ → Create App (type: Business) →
# add the "Instagram Graph API" product. See tools/instagram_api.py header for
# full step-by-step setup, including where to find your numeric user ID.
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_USER_ID=your_numeric_instagram_user_id
INSTAGRAM_ACCESS_TOKEN=

# ── Facebook Graph API (Page video posting) ──────────────────────────────────────
# Can reuse the same Meta App created for Instagram above — just add the
# "Facebook Pages" product. See tools/facebook_api.py header for full setup.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ID=your_numeric_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=
