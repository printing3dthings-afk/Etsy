# Runtime files generated by the server — do NOT commit these.
# They persist on disk across updates because Update.bat skips the data/ folder.
task_history.json
agent_states.json
session_log.json
orders_seen.json
design_refs_meta.json
ideas.json
product_pipeline.json
automation_chains.json
shop_data.json
improvement_log.json
schedule.json

# Knowledge base — standards and research are committed (business rules)
# knowledge_base/  ← intentionally tracked; DO NOT re-ignore

# Generated product files — binary, large, machine-local
digital_products/
svg_test/

# SVG bundle outputs — ZIPs, PNGs, SVGs, mockups are machine-local binaries
# Manifests (manifest.json) ARE committed as state tracking
svg_bundles/*/PNG/
svg_bundles/*/SVG/
svg_bundles/*/mockups/
svg_bundles/*/listing_photos/
svg_bundles/*.zip
svg_bundles/*/*.zip

# Sublimation generated outputs — large binaries
sublimation_samples/
sublimation_mockups/
sublimation_pack/

# Automated backups — local only
backups/

# Brand config — local shop-specific runtime data
brand/
