logs/

# Node
node_modules/
mobile_app/node_modules/

# Local hub database (use Railway Volume in prod)
hub_data/
*.db
*.db-wal
*.db-shm

# Staged photos pending Action Center approval (use Railway Volume in prod)
data/staged_photos/

# Reference Photos library (2026-07-22 Create-screen redesign) -- Scott's own
# uploaded inspiration/style-reference images, runtime content (use Railway
# Volume in prod, same as staged_photos above).
data/reference_images/
data/reference_images_meta.json

# Drafted review responses (tools/review_monitor.py) and the seen-reviews
# dedupe state -- can reference real buyer review text. 2026-07-15 security
# audit: these were the only two data/ paths with buyer-adjacent content and
# no gitignore entry (everything else that could hold PII was already
# covered above).
data/message_drafts/
data/reviews_seen.json
data/reviews_replied.json

# Order-notification dedupe state (tools/order_notifier.py) -- receipt IDs
# only, no buyer names, but proactively excluded anyway (2026-07-18
# compliance pass): was untracked with no rule, so an accidental `git add -A`
# had nothing stopping it from committing it.
data/notified_orders.json

# Distribution build artifacts (generated by tools/installer/package_template.py and
# tools/desktop/build_backend.py -- dist/desktop-backend/, dist/desktop-app/)
dist/
# PyInstaller's own work directory (tools/desktop/build_backend.py's --workpath) --
# anchored to repo root only, NOT desktop/build/ (that one holds the committed icon.png/
# icon.ico the Electron build actually needs).
/build/

# Generated social media videos and studio uploads (runtime output — large binaries)
data/social/videos/
data/social/studio_uploads/
data/social/staged_videos/
data/social/image_proofs/
data/social/_rejects/
data/social/svg_conversions/
data/social/lifestyle_photos/

# Browser tool screenshots (runtime output from tools/browser_automation.py)
data/browser_screenshots/

# graphify generated codebase-graph output + AST cache (regenerate with `graphify update .`)
graphify-out/
