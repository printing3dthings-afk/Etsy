// Giant Love Letter Mailbox: MakerWorld customizer (2026-11-05).
// Type the child's name; it is raised on the address side in Fredoka SemiBold
// and sized to fit. One print: the envelope's body (the lid and Cupid are their
// own prints in the model's 3MF files).
//
// Built by build_customizer.py from love_letter.scad. Everything but the name is
// one polyhedron here, computed once from the design, so the render makes a
// single union: about 16 s under OpenSCAD 2021's CGAL engine (24 s for a
// ten-letter name) and under a second with Manifold. As booleans the body took
// about 66 minutes under CGAL, and MakerWorld gives up after about a minute.
// check_customizer.py measures it against the shipped design.
// Do not edit the data below by hand; rebuild it.

// The child's name, on the address side
NAME = "OLIVIA";

/* [Hidden] */
SH = 1.2;
D = 62;
$fa = 2; $fs = 0.3; $fn = 36;
NAME_FONT = "Fredoka:style=SemiBold";
NAME_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 -'.!&";
NAME_ADV = [0.9847, 0.8597, 0.8931, 0.9264, 0.8472, 0.8597, 0.9931, 0.9194, 0.3222, 0.7444, 0.8264, 0.7847, 1.1306, 0.9486, 1.007, 0.8292, 1.1, 0.8486, 0.7583, 0.9, 0.9556, 1.0097, 1.3236, 0.9597, 0.8861, 0.8194, 0.7819, 0.7819, 0.7014, 0.7847, 0.7458, 0.5625, 0.7667, 0.7694, 0.3361, 0.3278, 0.7, 0.4181, 1.1153, 0.7819, 0.7764, 0.7667, 0.7653, 0.5875, 0.6361, 0.5708, 0.7778, 0.7833, 1.0361, 0.7264, 0.7764, 0.75, 0.7944, 0.5319, 0.8014, 0.7944, 0.7625, 0.6958, 0.7306, 0.7403, 0.7597, 0.7306, 0.3347, 0.5708, 0.2625, 0.3014, 0.3361, 0.975];
function name_adv(c) = let (i = search(c, NAME_CHARS)) len(i) && i[0] != [] ? NAME_ADV[i[0]] : 0.8;
function name_pre(s, sp, n) = n <= 0 ? 0 : name_pre(s, sp, n - 1) + name_adv(s[n - 1]) * sp;
function name_width(s, spacing = 1) = name_pre(s, spacing, len(s));
function name_fit(s, w, h, spacing = 1) = min(h, w / name_width(s, spacing));
module name_text(s, size, spacing = 1)
    translate([-name_width(s, spacing) * size / 2, 0])
        for (i = [0 : len(s) - 1])
            translate([name_pre(s, spacing, i) * size, 0])
                text(s[i], size = size, font = NAME_FONT, valign = "center", $fn = 12);

function art_n(h, n, sh = SH) = max(n, ceil(h * sh / 0.2));

module art_skirt(h, n, sh = SH) let (m = art_n(h, n, sh)) for (i = [0 : m - 1]) let (t0 = i == 0 ? -0.01 : i * h / m - 0.01,
        t1 = (i + 1) * h / m, k = ceil(sh * (h - t1) / 0.2 - 0.05))
    translate([0, 0, t0]) linear_extrude(t1 - t0) offset(delta = 0.01) union() for (j = [0 : max(k, 0)]) translate([0, -j * 0.2]) children();

module front(h, z0 = 0) translate([0, -D / 2 - z0, 0]) rotate([90, 0, 0]) art_skirt(h, 1) children();
module name2d() translate([34, 50]) name_text(NAME, name_fit(NAME, 88, 20, 1.1), 1.1);

module name_relief() if (len(NAME) > 0) front(1.0) name2d();

union() {
    body();
    name_relief();
}

