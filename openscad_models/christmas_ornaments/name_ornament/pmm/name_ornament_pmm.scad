// Personalised Name Ornament: MakerWorld customizer (OnBrandCraftz).
// Generated by pmm/build_pmm.py from name_ornament.scad: edit that, not this.
//
// A domed half-bauble, 80 mm across, with the name and the year inlaid flush
// into its face in a second colour, and a star above. Print it as it lies,
// dome up, supports off, 0.2 mm layers.

/* [Personalise] */
// The name across the dome (up to about 11 letters)
NAME = "Olivia";
// The year under the name
YEAR = "2026";

/* [Colours] */
// The ornament
ORNAMENT_COLOUR = "#C62F3A"; // color
// The name, year, star and maker's mark
NAME_COLOUR = "#F4F1EA"; // color

/* [Hidden] */
// Personalised name ornament (2026-10-21). Scott picked the domed half-bauble
// (1E) from five: a smooth dome, flat behind, with the buyer's name and the
// year inlaid flush into its face in a second colour, the same way the OBC
// mark is inlaid under the village. A star above the name; the maker's mark
// inlaid in the back in the same second colour, so it costs no extra change.
//
// Printed flat, back on the plate, dome up: every face is a top surface or a
// vertical edge, so nothing overhangs.
//
//   NAME, YEAR     the personalisation; NAME up to about 11 letters
//   part = body | inlay | union | all
// ---- inlined from openscad_models/brand/obc_mark.scad ----
// The OBC maker's mark (2026-10-14), from the logo Scott chose: OBC in a heavy
// geometric face, struck through with horizontal stripes. One drawing for
// every model, so every print carries the same mark.
//
// It goes on the underside as an INLAY: the letters cut 0.6 mm in and filled
// in a contrasting colour, flush with the base. On a white base that reads as
// crisp dark letters straight off the bed; engraved white on white, the old
// mark barely showed. The logo's stripes become grooves one layer deep across
// the letters' face: each catches a shadow, like the ridges on the gold logo,
// and the letters stay whole in colour above them, so they read at any size.
//
// Struck right through the letters, as in the logo, the stripes failed both
// ways (2026-10-14): in plastic a stripe cannot be finer than two beads, so at
// 4-6 mm one stripe took out the B's middle bar and it stopped reading as a B,
// and at 8-10 mm the stripes were as wide as the letter between them and OBC
// broke up like a barcode.
//
//   obc_inlay(h)     the coloured part, h = cap height in mm: give it to the
//                    contrasting colour
//   obc_cut(h)       what to subtract from the base: the whole letters, so
//                    the grooves are open, not left in the base's colour
//   obc_engrave(h)   the same as a cutter, for a one-colour model
//   obc_mark_width(h)
// Both are mirrored to read from below, sit on z = 0 and are centred on the
// origin; translate them to the spot on the base.
// They read OBC when the piece is tipped back to look underneath: front edge
// (-y) away from you. That is how Scott turned his first cottage over, and
// the old mirror([1, 0, 0]) read "ƆᗺO" that way: right only if you turned
// the piece side to side instead (2026-10-25). tests/test_obc_mark_reading.py
// checks it from the real geometry.
//
// The letters are Montserrat ExtraBold, the logo's face, set 0.95 apart (the
// logo's are almost touching; in plastic every gap needs two beads, 0.9). The
// drawing is cleaned the way a nozzle draws, so what it shows is what prints.

OBC_FONT = "Montserrat:style=ExtraBold";
OBC_GAP = 0.95;             // between letters, and each groove's width
OBC_BAND = 1.1;             // letter face left between two grooves
OBC_INLAY = 0.6;            // the inlay's depth: three layers at 0.2
OBC_GROOVE = 0.2;           // the grooves' depth: the first layer

// glyph boxes at size 10, measured: [letter, ink start, ink width] (2026-10-14)
OBC_GLYPHS = [["O", 0.48, 10.79], ["B", 0.98, 9.24], ["C", 0.48, 9.52]];
function obc_u(h) = h / 9.72;                       // text size per mm of cap height
function obc_mark_width(h) = 29.55 * obc_u(h) + 2 * OBC_GAP;
function obc_grooves(h) = max(0, floor((h + OBC_GAP) / (OBC_BAND + OBC_GAP)) - 1);

module obc_letters(h) let (u = obc_u(h), x0 = -obc_mark_width(h) / 2) {
    for (i = [0 : 2]) let (g = OBC_GLYPHS[i],
            start = x0 + (i == 0 ? 0 : i == 1 ? 10.79 * u + OBC_GAP : (10.79 + 9.24) * u + 2 * OBC_GAP))
        translate([start - g[1] * u, -h / 2]) text(g[0], size = 10 * u, font = OBC_FONT, halign = "left", valign = "baseline");
}
module obc_grooves2d(h) let (n = obc_grooves(h), b = (h - n * OBC_GAP) / (n + 1))
    for (k = [1 : n]) translate([-50, -h / 2 + k * b + (k - 1) * OBC_GAP]) square([100, OBC_GAP]);

// cleaned as a nozzle draws: gaps under 0.85 closed, strokes under a bead opened
module obc_clean() offset(r = 0.21, $fn = 12) offset(delta = -0.21) offset(r = -0.425, $fn = 12) offset(delta = 0.425) children();

module obc_solid2d(h) obc_clean() obc_letters(h);                                   // the letters
module obc_face2d(h) obc_clean() difference() { obc_solid2d(h); obc_grooves2d(h); } // their face: the bands between grooves

// the coloured part: the face in the first layer, the whole letters above it.
// It stands 0.02 proud of its cut: exactly on it, the inlay's outline and the
// cut's met at near-coincident faces and the welded print had open edges
// round the letters (2026-10-14). Split into colours, the inlay takes the
// overlap, so the colour boundary does not move.
module obc_inlay(h, depth = OBC_INLAY) mirror([0, 1, 0]) {
    linear_extrude(OBC_GROOVE + 0.01) offset(delta = 0.02) obc_face2d(h);
    translate([0, 0, OBC_GROOVE]) linear_extrude(depth - OBC_GROOVE) offset(delta = 0.02) obc_solid2d(h);
}
module obc_cut(h, depth = OBC_INLAY) mirror([0, 1, 0]) translate([0, 0, -0.5]) linear_extrude(depth + 0.5) obc_solid2d(h);
// as a cutter: the face's bands in the first layer, the whole letters above,
// so the grooves stay at the face as ridges. Built from the same two shapes as
// the inlay: subtracting one cleaned outline from the other left slivers of
// no width and a mesh CGAL would not close (2026-10-21, its first use).
// inset > 0 pulls the cut in that far all round: the walls left between the
// letters and the ridges across them grow by twice it. A one-colour mark has no
// inlay to fill them, and at the logo's 0.95 they read as walls under the
// gate's 1.2 floor (the nativity, 2026-10-21).
// ridges = false cuts the letters whole: with no inlay above them, the ridges
// are strips one layer thick and the gate reads them as 0.2 mm walls.
module obc_engrave(h, depth = 0.8, inset = 0, ridges = true) mirror([0, 1, 0]) {
    if (ridges) {
        translate([0, 0, -0.5]) linear_extrude(0.5 + OBC_GROOVE + 0.01) offset(delta = -inset) obc_face2d(h);
        translate([0, 0, OBC_GROOVE]) linear_extrude(depth - OBC_GROOVE) offset(delta = -inset) obc_solid2d(h);
    } else translate([0, 0, -0.5]) linear_extrude(depth + 0.5) offset(delta = -inset) obc_solid2d(h);
}
// ---- end of obc_mark.scad ----


$fn = 160;
RD   = 40;          // the ornament's radius: 80 mm across
RIM  = 3.0;         // the vertical band round its edge
HD   = 10;          // the dome's rise above the band
RS   = (RD * RD + HD * HD) / (2 * HD);   // the sphere the dome is cut from
DEEP = 0.6;         // the inlay's depth: three layers

NAME_FONT = "Lobster:style=Regular";
YEAR_FONT = "Montserrat:style=ExtraBold";
// the name's size: as large as fits 60 mm across, at most 12, from
// Lobster's advances (measured with textmetrics; PMM may not have it)
NAME_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 -'.!&";
NAME_ADV = [0.9278, 0.8903, 0.6903, 0.9208, 0.6375, 0.6375, 0.8028, 0.9236, 0.5208, 0.7444, 0.8347, 0.5264, 1.0931, 0.9278, 0.9236, 0.7958, 0.9236, 0.8347, 0.7917, 0.6681, 0.9944, 0.8542, 1.3361, 0.8611, 0.8611, 0.7528, 0.6486, 0.6167, 0.4736, 0.6611, 0.5083, 0.3708, 0.6667, 0.6292, 0.2903, 0.2958, 0.6556, 0.2875, 0.9736, 0.6306, 0.6764, 0.65, 0.675, 0.5222, 0.4389, 0.3833, 0.6375, 0.575, 0.9181, 0.6945, 0.6389, 0.5944, 0.7583, 0.4403, 0.6833, 0.7139, 0.6611, 0.7181, 0.6945, 0.6444, 0.6931, 0.6792, 0.3014, 0.4028, 0.2722, 0.3653, 0.3569, 0.9472];
function name_adv(c) = let (i = search(c, NAME_CHARS)) len(i) && i[0] != [] ? NAME_ADV[i[0]] : 0.7;
function name_w(s, n) = n <= 0 ? 0 : name_w(s, n - 1) + name_adv(s[n - 1]);
NAME_SIZE = len(NAME) == 0 ? 12 : min(12, 60 / name_w(NAME, len(NAME)));

module dome() {
    cylinder(r = RD, h = RIM);
    intersection() {
        translate([0, 0, RIM + HD - RS]) sphere(r = RS, $fn = 240);
        cylinder(r = RD, h = RIM + HD + 1);
    }
}
// the dome's skin DEEP thick, measured straight down: what the inlay may fill
module skin() difference() { dome(); translate([0, 0, -DEEP]) dome(); }

// cleaned as a nozzle draws (as the OBC mark): gaps under 0.85 closed,
// strokes under a bead opened
module clean() offset(r = 0.21, $fn = 12) offset(delta = -0.21) offset(r = -0.425, $fn = 12) offset(delta = 0.425) children();

module star2d(r) polygon([for (i = [0 : 9]) let (a = 90 + 36 * i, rr = i % 2 ? r * 0.45 : r) [rr * cos(a), rr * sin(a)]]);
module face2d() clean() {
    translate([0, 1.5]) text(NAME, size = NAME_SIZE, font = NAME_FONT, halign = "center", valign = "center");
    translate([0, -15]) text(YEAR, size = 5.5, font = YEAR_FONT, halign = "center", valign = "center", spacing = 1.15);
    translate([0, 19]) star2d(4.2);
}

// the loop at the top: a 4.4 mm hole for a hook or ribbon
LOOP_RO = 4.8; LOOP_RI = 2.2;
module loop() translate([0, RD + LOOP_RO - 1.6, 0]) difference() {
    cylinder(r = LOOP_RO, h = RIM, $fn = 48);
    translate([0, 0, -1]) cylinder(r = LOOP_RI, h = RIM + 2, $fn = 48);
}

MARK_H = 5.0;       // the maker's mark's cap height, in the middle of the back
module inlay() {
    intersection() { skin(); linear_extrude(RIM + HD + 2) face2d(); }
    obc_inlay(MARK_H);
}
module body() difference() { union() { dome(); loop(); } inlay(); obc_cut(MARK_H); }

// ---- what MakerWorld exports: two colours, centred on (0, 0) ----
// (PMM's preview centres the plate on the origin; its export arranges the
// model onto the plate. At (128, 128) it showed off the plate's corner.)
PLATE_CENTRE = [0, 0];
translate([PLATE_CENTRE[0], PLATE_CENTRE[1], 0]) {
    color(ORNAMENT_COLOUR) body();
    color(NAME_COLOUR) inlay();
}
